POSTGRES_DB=retail_finance
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=retail_password
POSTGRES_PORT=5432

# Inside Docker, keep DB_HOST=postgres. Use localhost when running Python on the host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=retail_finance
DB_USER=retail_user
DB_PASSWORD=retail_password

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

SOURCE_FILE=/opt/airflow/data/Data Engineer Analyst - Study Case.xlsx
SQL_DIR=/opt/airflow/sql
